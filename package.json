{
  "name": "filmfile",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "pnpm --filter @filmfile/backend start",
    "start:dev": "mkdir -p .dev-folder && FILMFILE_FOLDER=\"$PWD/.dev-folder\" pnpm start",
    "dev": "mkdir -p .dev-folder && FILMFILE_FOLDER=\"$PWD/.dev-folder\" FILMFILE_UI_ORIGIN=http://localhost:5173 pnpm --parallel --filter @filmfile/backend --filter @filmfile/web dev",
    "build": "pnpm --filter @filmfile/web build",
    "desktop": "pnpm build && pnpm --filter @filmfile/desktop start",
    "package": "pnpm build && pnpm --filter @filmfile/desktop package",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run --coverage",
    "e2e": "pnpm build && playwright test",
    "e2e:web": "pnpm build && playwright test --project chromium",
    "generate": "vitest run apps/backend/test/api/openapi.test.ts -u && vitest run packages/contracts -u"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-boundaries": "~7.4.2",
    "fast-check": "^4.10.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
